{
  "about": "The sales Calendar's own query rows for FY26, exported from the Report's model in Power BI Desktop by report/desktop (npm run export-fixture). Its fields and their order are the Calendar's; dates are yyyy-mm-dd text; a blank measure value is null. Harness fixture 'report-sales-fy26'. Do not edit: export again.",
  "source": "report/Daily Sales.Report/definition/pages/dailyOverview/visuals/calendar/visual.json",
  "dateFilter": "TREATAS ( { \"FY26\" }, 'DimDate'[FYear] ), in place of the page's date filter",
  "query": [
    "DEFINE",
    "    VAR __DS0FilterTable = TREATAS ( { \"FY26\" }, 'DimDate'[FYear] )",
    "",
    "    VAR __DS0Core =",
    "        SUMMARIZECOLUMNS(",
    "            'DimDate'[Date],",
    "            __DS0FilterTable,",
    "            \"Measure_Table_Days_in_Filter\", 'Measure Table'[Days in Filter],",
    "            \"Measure_Table_Total_Sales\", 'Measure Table'[Total Sales]",
    "        )",
    "",
    "    VAR __DS0PrimaryWindowed =",
    "        TOPN(1001, __DS0Core, 'DimDate'[Date], 1)",
    "",
    "EVALUATE",
    "SELECTCOLUMNS (",
    "    __DS0Core,",
    "    \"Date\", FORMAT ( 'DimDate'[Date], \"yyyy-mm-dd\" ),",
    "    \"Days in Filter\", [Measure_Table_Days_in_Filter],",
    "    \"Sales\", [Measure_Table_Total_Sales]",
    ")",
    "ORDER BY [Date]",
    ""
  ],
