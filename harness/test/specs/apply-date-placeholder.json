{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Harness test strip (valid). Every day of 2025 as a small square, as in strip.json. A left click on a day applies an expression with a _{date}_ placeholder, which Deneb fills from the clicked day's datum before it evaluates the expression. Deneb 2.0 writes a Date as toDate('<ISO string>') and Deneb 1.9 as toDate('<Date.toString()>'), so the resolved expression tells the two apart.",
  "width": {"signal": "pbiContainerWidth"},
  "height": {"signal": "pbiContainerHeight"},
  "padding": 0,
  "signals": [
    {"name": "selectionLimit", "value": 2500},
    {
      "name": "applyResult",
      "value": {},
      "on": [
        {
          "events": "@cell:click[event.button === 0]",
          "update": "pbiCrossFilterApply(event, \"time(toDate(datum['Date'])) == time(_{date}_)\", {limit: selectionLimit})"
        }
      ]
    }
  ],
  "data": [
    {"name": "dataset"},
    {
      "name": "days",
      "transform": [
        {"type": "sequence", "start": 0, "stop": 365, "as": "idx"},
        {"type": "formula", "as": "date", "expr": "datetime(2025, 0, 1 + datum.idx)"}
      ]
    }
  ],
  "marks": [
    {
      "type": "rect",
      "name": "cell",
      "from": {"data": "days"},
      "encode": {
        "update": {
          "x": {"signal": "8 + floor(datum.idx / 7) * 14"},
          "y": {"signal": "8 + (datum.idx % 7) * 14"},
          "width": {"value": 12},
          "height": {"value": 12},
          "fill": {"value": "#5693e3"}
        }
      }
    }
  ]
}
