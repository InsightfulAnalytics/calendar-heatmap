{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Harness test spec, deliberately wrong: the apply expression reads loMs and hiMs, which are signals of a group mark. Deneb seeds its headless view with top-level signals only, so the expression cannot be evaluated.",
  "width": {
    "signal": "pbiContainerWidth"
  },
  "height": {
    "signal": "pbiContainerHeight"
  },
  "padding": 0,
  "signals": [
    {
      "name": "selectionLimit",
      "value": 2500
    },
    {
      "name": "downIdx",
      "value": null,
      "on": [
        {
          "events": "@cell:mousedown[event.button === 0]",
          "update": "datum.idx"
        },
        {
          "events": "view:mousedown[event.button === 0][!event.item || event.item.mark.name !== 'cell']",
          "update": "null"
        }
      ]
    },
    {
      "name": "headIdx",
      "value": null,
      "on": [
        {
          "events": "@cell:mousedown[event.button === 0]",
          "update": "datum.idx"
        },
        {
          "events": "[@cell:mousedown[event.button === 0], window:mouseup] > @cell:mouseover",
          "update": "datum.idx"
        }
      ]
    },
    {
      "name": "applyResult",
      "value": {},
      "on": [
        {
          "events": "view:mouseup[event.button === 0]",
          "update": "downIdx == null ? pbiCrossFilterClear() : pbiCrossFilterApply(event, \"inrange(time(toDate(datum['Date'])), [loMs, hiMs])\", {limit: selectionLimit})"
        }
      ]
    }
  ],
  "data": [
    {
      "name": "dataset"
    },
    {
      "name": "days",
      "transform": [
        {
          "type": "sequence",
          "start": 0,
          "stop": 365,
          "as": "idx"
        },
        {
          "type": "formula",
          "as": "date",
          "expr": "datetime(2025, 0, 1 + datum.idx)"
        }
      ]
    }
  ],
  "marks": [
    {
      "type": "group",
      "name": "panel",
      "signals": [
        {
          "name": "loMs",
          "update": "downIdx == null ? 0 : time(datetime(2025, 0, 1 + min(downIdx, headIdx)))"
        },
        {
          "name": "hiMs",
          "update": "downIdx == null ? 0 : time(datetime(2025, 0, 2 + max(downIdx, headIdx))) - 1"
        }
      ],
      "marks": [
        {
          "type": "rect",
          "name": "cell",
          "from": {
            "data": "days"
          },
          "encode": {
            "update": {
              "x": {
                "signal": "8 + floor(datum.idx / 7) * 14"
              },
              "y": {
                "signal": "8 + (datum.idx % 7) * 14"
              },
              "width": {
                "value": 12
              },
              "height": {
                "value": 12
              },
              "fill": {
                "value": "#5693e3"
              }
            }
          }
        }
      ]
    }
  ]
}