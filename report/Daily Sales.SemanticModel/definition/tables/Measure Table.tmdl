table 'Measure Table'
	lineageTag: 5fe0fae7-2d0f-4af8-a65c-4abec73aa188

	measure 'Dates Selected' = ```
			// Source: Rick de Groot / Datahub -- "Showing period selections in Power BI"
			// https://datahub.nl/showing-period-selections-in-power-bi/
			// Shipped with attribution; adapted for the DimDate column names in this skill's DimDate.tmdl.
			
			// Return selected Dates: Years, Month & Year, use with v3 date table
			
			    /* _________________________________________________________________________________________________________________________________________________________ */
			    // Adjust this variable to change the prefix used for the period title
			    VAR __PeriodPrefix =                "Selected Period: "
			    VAR __DiverseDates =                "a range of dates in "
			
			    // Define main start and end dates
			    VAR __StartDate =                   MIN( 'DimDate'[Date] )
			    VAR __EndDate =                     MAX( 'DimDate'[Date] )
			
			    // Provide information about the current context
			    VAR __DaysInCurrentContext =        COUNTROWS( DimDate ) 
			    VAR __DaysBetween_StartAndEnd =     DATEDIFF( __StartDate, __EndDate, DAY )  + 1
			    VAR __IsConsecutivePeriod =         __DaysBetween_StartAndEnd = __DaysInCurrentContext
			
			    // Day Related Variables
			    VAR __FormattedEndDate =            FORMAT( __EndDate, "d mmm yyyy" ) 
			
			    // Month related variables
			    VAR __FormattedStartDateMonth =     FORMAT( __StartDate, "mmm yyyy" )
			    VAR __FormattedEndMonth =           FORMAT( __EndDate,   "mmm yyyy" ) // "d mmm yyyy"
			    VAR __FiltersFullMonthsOnly =
			            VAR YearsSummary = SUMMARIZECOLUMNS( DimDate[MonthOfYear], 'DimDate'[Days In Month] )
			            VAR DaysInYears = ADDCOLUMNS( YearsSummary, "@DaysInContext", CALCULATE( COUNTROWS( DimDate ) ) )
			            VAR IncompleteMonths = FILTER( DaysInYears, [@DaysInContext] <> 'DimDate'[Days In Month] )
			            VAR Result = ISEMPTY( IncompleteMonths )
			        RETURN
			            Result
			
			    // Year related variables
			    VAR __IsSingleYear =                HASONEVALUE( 'DimDate'[Year] )
			    VAR __FiltersFullYearsOnly =
			        VAR YearsSummary = 
			            VALUES( 'DimDate'[Year] )
			        VAR IncompleteYearFlag = 
			            ADDCOLUMNS(
			                YearsSummary,
			                "@IsIncompleteYear",
			                    VAR DatesInContext = CALCULATE( COUNTROWS( DimDate ) )
			                    VAR DatesInYear = CALCULATE( MAX( 'DimDate'[Days in Year] ) )
			                    VAR IncompleteYearInContext = DatesInContext <> DatesInYear
			                RETURN
			                    IncompleteYearInContext
			                )
			        VAR IncompleteYears = 
			            FILTER(
			                IncompleteYearFlag,
			                [@IsIncompleteYear] = TRUE()
			                )
			        VAR Result = ISEMPTY( IncompleteYears )
			    RETURN
			        Result
			    VAR __Result = 
			        SWITCH( TRUE(),
			    /* _________________________________________________________________________________________________________________________________________________________  
			    Logic for creating a YEAR selection string */
			    
			    // Perform this logic only if full years are selected
			        __FiltersFullYearsOnly, 
			        
			        // Retrieve all Period Combinations that exist in the current filter context
			        VAR SelectedYears = VALUES( 'DimDate'[Year] )
			        // Find what the previous and next period is in the selection and add the values as a column
			        VAR AddPrev_Next_Year = 
			            ADDCOLUMNS(
			                SelectedYears,
			                "@PreviousPeriod", 
			                MAXX(
			                    FILTER(	SelectedYears,
			                        'DimDate'[Year] < EARLIER( 'DimDate'[Year] ) ),
			                    'DimDate'[Year] ),
			                "@NextPeriod", 
			                MINX(
			                    FILTER(	SelectedYears,
			                        'DimDate'[Year] > EARLIER( 'DimDate'[Year] ) ),
			                    'DimDate'[Year] )
			            )
			        /* Based on whether the previous or next period combination in the context is consecutive, define logic.
			            - The very last combination should end with a regular year value.
			            - The start of a range should start with a period and end with a dash "-" to indicate the start of a range
			            - All values within a range return blank, they don't need to be included
			            - A single month (outside of a range) or the last month in a range should both show: Period and a separator ( pipe symbol ) */
			            
			        VAR __ConcatenationLogic = 
			            ADDCOLUMNS( 
			                AddPrev_Next_Year,
			                "@PartOfRange",
			                    VAR __NextPeriod =  'DimDate'[Year] + 1
			                    VAR __PrevPeriod =  'DimDate'[Year] - 1
			                    VAR __StringElements = 
			                        SWITCH( TRUE(),
			                            ISBLANK( [@NextPeriod] ), 											      'DimDate'[Year], 	        // The last period in the context
			                            __NextPeriod <> [@NextPeriod] && __PrevPeriod <> [@PreviousPeriod],       'DimDate'[Year] & " | " ,    // A period outside of a range 
			                            __NextPeriod <> [@NextPeriod] && __PrevPeriod =  [@PreviousPeriod],       'DimDate'[Year] & " | " ,    // The last period value in a range
			                            __NextPeriod =  [@NextPeriod] && __PrevPeriod <> [@PreviousPeriod],       'DimDate'[Year] & " - " , 	// The first [Period] in a range
			                            __NextPeriod =  [@NextPeriod] && __PrevPeriod =  [@PreviousPeriod],       BLANK(), 					    // A period in the middle of a range
			                            __NextPeriod <> [@NextPeriod] && __PrevPeriod =  [@PreviousPeriod],       'DimDate'[Year] & " | "      // The last period in a range
			                        )
			                    RETURN __StringElements
			            )
			        RETURN
			        __PeriodPrefix & CONCATENATEX( __ConcatenationLogic, [@PartOfRange], "", 'DimDate'[Year], ASC ),
			            
			    /* _________________________________________________________________________________________________________________________________________________________
			        For month selections below calculation returns the right values: */
			            
			    // Check if users filter full months only
			        __FiltersFullMonthsOnly,
			        
			    // Retrieve all Start of Month Combinations that exist in the current filter context
			        VAR SelectedDates = VALUES( 'DimDate'[Start Of Month] )
			        VAR __MultipleYearsInContext = YEAR( __StartDate ) <> YEAR( __EndDate )
			        
			        // Find what the previous and next month-year combination is and add the values as a column
			        VAR AddPreviousDates = 
			            ADDCOLUMNS(
			                SelectedDates,
			                "@PreviousMonthYear", 
			                MAXX(
			                    FILTER(	SelectedDates,
			                        'DimDate'[Start Of Month] < EARLIER( 'DimDate'[Start Of Month] ) ),
			                    'DimDate'[Start Of Month] ),
			                "@NextMonthYear", 
			                MINX(
			                    FILTER(	SelectedDates,
			                        'DimDate'[Start Of Month] > EARLIER( 'DimDate'[Start Of Month] ) ),
			                    'DimDate'[Start Of Month] )
			            )
			        /* Based on whether the previous or next month-year combination in the context is consecutive, define logic.
			            - The very last combination should end with both the month (short) and the year value.
			            - The start of a range should start with month (short) and end with a dash "-" to indicate the start of a range
			            - All values within a range return blank, they don't need to be included
			            - A single month (outside of a range) or the last month in a range should both show: Month (short) and a separator (pipe symbol ) */
			
			        VAR __ConcatenationLogic = 
			            ADDCOLUMNS(
			                AddPreviousDates,
			                "@PartOfRange",
			                VAR  __NextMonth = EDATE( 'DimDate'[Start Of Month], 1 )
			                VAR  __PrevMonth = EDATE( 'DimDate'[Start Of Month], - 1 )
			                VAR  __StringElements = 
			                SWITCH(
			                    TRUE(),
			                    /* __________________ Multiple year logic ____________________________ */
			                    
			                    ISBLANK( [@NextMonthYear] ), FORMAT( 'DimDate'[Start Of Month], "mmm yyyy " ),   // The last period of all periods
			                    
			                    __NextMonth = [@NextMonthYear] && __PrevMonth <> [@PreviousMonthYear] && __MultipleYearsInContext, FORMAT( 'DimDate'[Start Of Month], "mmm yyyy - " ),     // The first period in a range, when multiple years are selected
			
			
			                    YEAR( [@NextMonthYear] ) <> YEAR( 'DimDate'[Start Of Month] ) && NOT ( __IsConsecutivePeriod ), FORMAT( 'DimDate'[Start Of Month], "mmm yyyy | " ),       // The last period in current year (in non consecutive selection)
			                    
			                    __MultipleYearsInContext && __NextMonth <> [@NextMonthYear] && __PrevMonth <> [@PreviousMonthYear], FORMAT( 'DimDate'[Start Of Month], "mmm yyyy | " ),    // A period outside of a range
			                    __MultipleYearsInContext && __NextMonth <> [@NextMonthYear] && __PrevMonth = [@PreviousMonthYear], FORMAT( 'DimDate'[Start Of Month], "mmm yyyy | " ),     // Last period value in a range
			                    
			                    /* __________________ Single Year Logic   ____________________________ */
			                    
			                    __NextMonth <> [@NextMonthYear] && __PrevMonth <> [@PreviousMonthYear], FORMAT( 'DimDate'[Start Of Month], "mmm | " ),     // A month outside of a range
			                    __NextMonth <> [@NextMonthYear] && __PrevMonth = [@PreviousMonthYear],  FORMAT( 'DimDate'[Start Of Month], "mmm | " ),     // The last date/month value in a range
			                    __NextMonth = [@NextMonthYear] && __PrevMonth <> [@PreviousMonthYear],  FORMAT( 'DimDate'[Start Of Month], "mmm - " ),     // The first period in a range, with a single year selection
			                    __NextMonth = [@NextMonthYear] && __PrevMonth = [@PreviousMonthYear],   BLANK()                                             // A month in the middle of a range
			                )
			                RETURN
			                __StringElements
			            )
			        VAR __RemoveMiddleOfRange = FILTER( __ConcatenationLogic, [@PartOfRange] <> "" )
			        VAR __YearRangeStartCorrection =
			            ADDCOLUMNS(
			                __RemoveMiddleOfRange,
			                "@RangeElements",
			                VAR __NextPartOfRange =
			                    MINX(
			                        FILTER(	__RemoveMiddleOfRange, 'DimDate'[Start Of Month] > EARLIER( 'DimDate'[Start Of Month] ) ),
			                        'DimDate'[Start Of Month] 
			                    )
			                VAR Result =
			                IF( 
			                    RIGHT( [@PartOfRange], 2 ) = "- " 
			                        && YEAR( __NextPartOfRange ) = YEAR( 'DimDate'[Start Of Month] ), 
			                    LEFT( [@PartOfRange], 3 ) & RIGHT( [@PartOfRange], 3 ),
			                    [@PartOfRange]
			                )
			                RETURN Result
			            )
			                        
			                        
			        RETURN
			        __PeriodPrefix & CONCATENATEX( __YearRangeStartCorrection, [@RangeElements], "", 'DimDate'[Start Of Month], ASC ),
			        
			    /* _________________________________________________________________________________________________________________________________________________________ 
			            When the selection consists of a single day, simply return the day */
			
			            __DaysInCurrentContext = 1,
			            __PeriodPrefix & FORMAT( VALUES( 'DimDate'[Date] ), "d mmm yyyy" ),
			        
			    /* _________________________________________________________________________________________________________________________________________________________
			            Define non-consecutive periods within the same month , e.g. 1 jan 2023, 5 jan 2023, 6 jan 2023 -> 
			            returns: niet openeenvolgende datums in Jan 2023 */
			                    VAR SameYearMonth =      __FormattedStartDateMonth = __FormattedEndMonth 
			                    RETURN  
			            __IsSingleYear &&  SameYearMonth && NOT( __IsConsecutivePeriod ),
			            __PeriodPrefix & __DiverseDates & __FormattedStartDateMonth,
			
			    /* _________________________________________________________________________________________________________________________________________________________
			            Define consecutive periods within the same month , e.g. 1 - 3 jan 2023
			            returns: niet openeenvolgende datums in Jan 2023 */
			                    VAR SameYearMonth =      __FormattedStartDateMonth = __FormattedEndMonth 
			
			                    RETURN  
			            __IsSingleYear &&  SameYearMonth &&  __IsConsecutivePeriod,
			                    VAR __FormattedStartDayShort = FORMAT( __StartDate, "d" )
			                    VAR __FormattedEndDayMonth = FORMAT( __EndDate, "d mmm yyyy" )
			                RETURN
			            __PeriodPrefix & __FormattedStartDayShort & " - " & __FormattedEndDayMonth,
			
			    /* _________________________________________________________________________________________________________________________________________________________
			            Define consecutive date range within the year where end date is not end of the month, but start date is start of the month. 
			            In those cases, return the short full date format of both the start and end date , e.g. 1 jan 2023 t/m 19 feb 2023-> 
			            returns: 1 jan 2023 - 19 feb 2023*/
			                VAR __DatesNotStartTillEndOfMonth =      __EndDate <>  EOMONTH( __EndDate, 0 ) || __StartDate =  ( EOMONTH( __StartDate, - 1 ) + 1 )
			            RETURN
			            __IsSingleYear && __DatesNotStartTillEndOfMonth /* && __StartDate_IsStartOfMonth */ && __IsConsecutivePeriod,
			                    VAR __FormattedStartDateShort = FORMAT( __StartDate, "d mmm" ) 
			                RETURN 
			                __PeriodPrefix & __FormattedStartDateShort & " - " & __FormattedEndDate
			            
			        )
			    RETURN     
			        
			    SWITCH(
			        TRUE(),
			        ISBLANK( __Result ), "Selected Period: See Date Slicers",
			        __Result
			    )
			```
		lineageTag: 9166b8f8-0420-44dc-9329-4a89b680522b

	/// Sum of the daily sales amounts in the current filter context. Blank when no sales row survives the filter.
	measure 'Total Sales' =
			
			// Add up the amount over the sales rows the filter context leaves
			SUM ( 'Sales'[Amount] )
		formatString: #,##0
		displayFolder: Sales
		lineageTag: f16a4951-e0f6-4195-8f3b-63c771a2cebd

	/// Calendar days in the current filter: a count of date table rows. Never blank for a date, so a calendar that binds it receives every date as a row, blank-sales days included.
	measure 'Days in Filter' =
			
			// One date table row per calendar day, so this counts the days in the filter
			COUNTROWS ( 'DimDate' )
		formatString: #,##0
		displayFolder: Dates
		lineageTag: c3c8a66a-7e84-4faf-9da1-ade0215a086e

	/// Total sales over every calendar day in the current date filter, blank days counted as zero, so the divisor is the days in the filter, not the days with sales. Reads 0 on a filter whose days have no sales, and blank only when the filter holds no days.
	measure 'Mean per Day' =
			
			// Every calendar day in the current date filter, counted from the date table, so days
			// with no sales rows are in the divisor
			VAR __Days =
			    COUNTROWS ( 'DimDate' )
			// The total over those days; a day with no sales adds zero
			VAR __Total =
			    COALESCE ( [Total Sales], 0 )
			// The mean per calendar day; blank only when the filter holds no days at all
			VAR __Result =
			    DIVIDE ( __Total, __Days )
			RETURN
			    __Result
		formatString: #,##0
		displayFolder: Sales
		lineageTag: ae8e88c7-918a-4613-84c8-2afe0abd1d89

	/// Sum of the daily sales targets in the current filter context. Targets carry channel and region like Sales, so a channel or region filter narrows the target with the sales it is compared against. Blank when no target row survives the filter.
	measure 'Total Target' =

			// Add up the target over the target rows the filter context leaves
			SUM ( 'Targets'[Target] )
		formatString: #,##0
		displayFolder: Targets
		lineageTag: f449e8a8-702f-4aa7-bcfc-e961d4f42e8f

	/// The mean daily target: the total target over every calendar day in the current date filter, a day with no target counted as zero, so it divides by the same days as Mean per Day and the two compare like with like. Blank only when the filter holds no days.
	measure 'Mean Daily Target' =

			// Every calendar day in the current date filter, counted from the date table, so days
			// with no target rows are in the divisor
			VAR __Days =
			    COUNTROWS ( 'DimDate' )
			// The total target over those days; a day with no target adds zero
			VAR __Target =
			    COALESCE ( [Total Target], 0 )
			// The mean per calendar day; blank only when the filter holds no days at all
			VAR __Result =
			    DIVIDE ( __Target, __Days )
			RETURN
			    __Result
		formatString: #,##0
		displayFolder: Targets
		lineageTag: 3f2f6858-c8ad-448e-b095-5216cf3660f1

	/// Days with sales in the current date filter, both the days and their sales read through the date table. Formatted out of the calendar days in the filter, such as 37 / 45, while the value stays a number. Reads 0 on a filter whose days have no sales, and blank only when the filter holds no days.
	measure 'Active Days' =
			
			// Every calendar day in the current date filter, from the date table
			VAR __Days =
			    VALUES ( 'DimDate'[Date] )
			// Keep the days whose sales are not blank
			VAR __ActiveDays =
			    FILTER (
			        __Days,
			        NOT ISBLANK ( [Total Sales] )
			    )
			// Count them: 0 when the filter holds days but none has sales, blank with no days
			VAR __Result =
			    IF (
			        NOT ISEMPTY ( __Days ),
			        COUNTROWS ( __ActiveDays ) + 0
			    )
			RETURN
			    __Result
		displayFolder: Sales
		lineageTag: 7cb7f973-161a-468e-ada5-a343dc60b187

		formatStringDefinition = Fmt.OutOf ( [Days in Filter] )

	/// The date of the best day in the current date filter: the day with the highest total sales, the earliest date on a tie. Blank when no day in the filter has sales.
	measure 'Peak Day' =
			
			// Each calendar day in the current date filter, with its sales
			VAR __Days =
			    ADDCOLUMNS (
			        VALUES ( 'DimDate'[Date] ),
			        "@Sales", [Total Sales]
			    )
			// Only a day with sales can be the peak
			VAR __SalesDays =
			    FILTER (
			        __Days,
			        NOT ISBLANK ( [@Sales] )
			    )
			// The best day; on a tie, the earliest date wins
			VAR __Peak =
			    TOPN (
			        1,
			        __SalesDays,
			        [@Sales], DESC,
			        'DimDate'[Date], ASC
			    )
			VAR __Result =
			    MAXX ( __Peak, 'DimDate'[Date] )
			RETURN
			    __Result
		formatString: d mmm yyyy
		displayFolder: Sales
		lineageTag: 486cbe23-470d-4dd9-a9e3-7a95adcad9f7

	/// The Peak day value: the best day's total sales in the current date filter, the sales of the Peak Day. Blank when no day in the filter has sales.
	measure 'Peak Day Sales' =

			// Each calendar day in the current date filter, with its sales
			VAR __Days =
			    ADDCOLUMNS (
			        VALUES ( 'DimDate'[Date] ),
			        "@Sales", [Total Sales]
			    )
			// The highest daily total; a day without sales is blank and never counts
			VAR __Result =
			    MAXX ( __Days, [@Sales] )
			RETURN
			    __Result
		formatString: #,##0
		displayFolder: Sales
		lineageTag: 532f384e-719e-49f7-a3a5-fbe2a0bddbc3

	/// Total Sales for a KPI card that draws one row per week (grouped by DimDate WeekEnding): the week on the row is lifted and every other filter kept (the date filter, a Calendar Selection, channel and region), so each weekly row carries the card's headline. Reads 0 when the filter holds days but none has sales, so the card keeps its rows; blank only when the filter holds no days.
	measure 'Card Total Sales' =

			// The card's whole filter: lift the week the row is grouped by, keep every other filter
			VAR __Total =
			    CALCULATE (
			        [Total Sales],
			        REMOVEFILTERS ( 'DimDate'[WeekEnding] )
			    )
			// The calendar days in that filter, to tell no sales (0) from no days (blank)
			VAR __Days =
			    CALCULATE (
			        COUNTROWS ( 'DimDate' ),
			        REMOVEFILTERS ( 'DimDate'[WeekEnding] )
			    )
			VAR __Result =
			    IF (
			        __Days > 0,
			        COALESCE ( __Total, 0 )
			    )
			RETURN
			    __Result
		formatString: #,##0
		displayFolder: KPI cards
		lineageTag: bce148e2-ab8b-4969-b00b-246796ac44d2

	/// A day's total sales when it is one of the five best days in the visual's filter (slicers, page filters and any Calendar Selection), blank otherwise, so a visual that binds the date and this measure shows exactly the Top days. Ties go to the earlier date; days without sales never appear.
	measure 'Top Day Sales' =
			
			// The day on the current row, when there is exactly one
			VAR __Day =
			    SELECTEDVALUE ( 'DimDate'[Date] )
			// Every day in the visual's filter, with its sales. ALLSELECTED on the date table, as a
			// filter, drops the row's own date and keeps the outer filters; ALLSELECTED on the date
			// column, as a table, would return every date whatever the page filter says
			VAR __Days =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            VALUES ( 'DimDate'[Date] ),
			            ALLSELECTED ( 'DimDate' )
			        ),
			        "@Sales", [Total Sales]
			    )
			// The five best days that have sales; ties go to the earlier date
			VAR __Top =
			    TOPN (
			        5,
			        FILTER (
			            __Days,
			            NOT ISBLANK ( [@Sales] )
			        ),
			        [@Sales], DESC,
			        'DimDate'[Date], ASC
			    )
			// The current day's sales when it is one of the five, blank otherwise
			VAR __Result =
			    IF (
			        NOT ISBLANK ( __Day )
			            && __Day IN SELECTCOLUMNS ( __Top, "@Date", 'DimDate'[Date] ),
			        [Total Sales]
			    )
			RETURN
			    __Result
		formatString: #,##0
		displayFolder: Sales
		lineageTag: 4bb725df-85af-4eda-84a0-ab419ee3232b

	column Column1
		dataType: string
		isHidden
		lineageTag: 40035f8b-e3ed-4ae6-9e90-04d5d1561043
		summarizeBy: none
		sourceColumn: Column1

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition 'Measure Table' = m
		mode: import
		queryGroup: Others
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

